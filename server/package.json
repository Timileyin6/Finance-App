{
  "name": "finance-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-env.js && prisma db push && node prisma/seed.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --import ./test/env.js --test test/*.test.js",
    "samples": "node scripts/make-sample-statements.js",
    "db:clear": "node --env-file=.env scripts/clear-transactions.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
