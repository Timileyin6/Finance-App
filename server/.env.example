# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origin the browser app is served from (used for cookie + redirect checks)
CLIENT_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────
# Local development uses SQLite (a file, zero setup).
# For production, switch to PostgreSQL — see README "Database".
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────
# Long random strings. `npm run setup` fills these in for you.
JWT_SECRET=

# ── Money display ─────────────────────────────────────
CURRENCY=NGN
LOCALE=en-NG

# ── Mono (automatic bank transactions, Nigeria) ───────────
# Leave blank to run with manual transactions only.
# Get keys at https://app.mono.co → Apps → your app. Test keys start with test_.
MONO_PUBLIC_KEY=
MONO_SECRET_KEY=
# Any long random string; paste the same value into your webhook settings on the Mono dashboard.
# Webhook URL to register there: https://your-app.com/api/bank/webhook
MONO_WEBHOOK_SECRET=
# true = fetch live from the bank on every sync (slower, may cost extra)
MONO_REALTIME=false
# How often to pull new transactions for every linked account
MONO_SYNC_INTERVAL_MINUTES=360
